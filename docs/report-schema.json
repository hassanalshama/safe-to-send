{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hassanalshama.github.io/safe-to-send/report-schema.json",
  "title": "Safe to Send report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scanner",
    "scannedAt",
    "durationMs",
    "file",
    "verdict",
    "findings",
    "counts",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "Safe to Send"
        },
        "version": {
          "type": "string",
          "const": "0.1.0"
        }
      }
    },
    "scannedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "type",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "summary",
        "score"
      ],
      "properties": {
        "code": {
          "enum": [
            "DO_NOT_SEND",
            "REVIEW",
            "INCOMPLETE",
            "NO_OBVIOUS_RISKS"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "severity",
          "confidence",
          "title",
          "summary",
          "location",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high",
        "medium",
        "low",
        "info",
        "total"
      ],
      "properties": {
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "checks",
        "limitations",
        "details"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
